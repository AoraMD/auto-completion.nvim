#!/usr/bin/env python3

"""Minimal LSP server that translates textDocument/inlineCompletion requests
into Deepseek FIM Beta API calls.

Communicates over stdin/stdout via JSON-RPC 2.0 framed with the LSP base
protocol (Content-Length header).  Requires the DEEPSEEK_API_KEY environment
variable to be set.

Usage:
    DEEPSEEK_API_KEY=sk-... deepseek-fim-server
"""

from __future__ import (
    annotations,
)

import json
import os
import sys
import threading
import urllib.request
from typing import (
    TYPE_CHECKING,
    Any,
)

if TYPE_CHECKING:
    from collections.abc import (
        Mapping,
    )


def _read_message() -> dict[str, Any] | None:
    headers: dict[str, str] = {}
    while True:
        raw = sys.stdin.buffer.readline()
        if not raw:
            return None
        line = raw.decode("utf-8").rstrip("\r\n")
        if line == "":
            break
        if ":" in line:
            key, value = line.split(":", 1)
            headers[key.strip().lower()] = value.strip()

    content_length = int(headers.get("content-length", "0"))
    if content_length == 0:
        return None

    body = sys.stdin.buffer.read(content_length).decode("utf-8")
    return json.loads(body)


def _write_message(
    msg: Mapping[str, Any],
) -> None:
    body = json.dumps(msg, ensure_ascii=False)
    body_bytes = body.encode("utf-8")
    header = f"Content-Length: {len(body_bytes)}\r\n\r\n"
    with _write_lock:
        sys.stdout.buffer.write(header.encode("utf-8"))
        sys.stdout.buffer.write(body_bytes)
        sys.stdout.buffer.flush()


def _log(
    msg: str,
) -> None:
    print(f"[auto-completion] {msg}", file=sys.stderr, flush=True)


def _read_int_env(
    name: str,
    default: int,
) -> int:
    value = os.environ.get(name)
    if value is None:
        return default

    try:
        return int(value)
    except ValueError:
        _log(f"Ignoring invalid {name}: {value}")
        return default


def _send_response(
    msg_id: Any,
    result: Any,
) -> None:
    if msg_id is None:
        return

    _write_message(
        {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": result,
        },
    )


def _send_error(
    msg_id: Any,
    code: int,
    message: str,
) -> None:
    if msg_id is None:
        return

    _write_message(
        {
            "jsonrpc": "2.0",
            "id": msg_id,
            "error": {
                "code": code,
                "message": message,
            },
        },
    )


_documents: dict[str, str] = {}
_document_versions: dict[str, int] = {}
_state_lock = threading.Lock()
_write_lock = threading.Lock()
_pending_inline_completion: dict[str, Any] | None = None
_canceled_request_ids: set[Any] = set()
_completion_token = 0

_API_KEY = os.environ.get("DEEPSEEK_API_KEY", "")

_ENDPOINT = "https://api.deepseek.com/beta/completions"
_MODEL = "deepseek-v4-pro"
_MAX_TOKENS = 256
_PREFIX_MAX_CHARS = 4096
_SUFFIX_MAX_CHARS = 2048
_DEBOUNCE_MS = max(0, _read_int_env("AUTO_COMPLETION_DEBOUNCE_MS", 250))
_REQUEST_CANCELLED = -32800


def _cancel_pending_inline_completion_locked() -> Any | None:
    global _pending_inline_completion

    pending = _pending_inline_completion
    if pending is None:
        return None

    pending["timer"].cancel()
    _pending_inline_completion = None
    return pending["id"]


def _invalidate_inline_completions_locked() -> Any | None:
    global _completion_token

    _completion_token += 1
    return _cancel_pending_inline_completion_locked()


def _extract_fim(
    text: str,
    line: int,
    character: int,
) -> tuple[str, str]:
    if not text:
        return "", ""

    doc_lines = text.split("\n")

    prefix_parts = doc_lines[:line]
    if line < len(doc_lines):
        prefix_parts.append(doc_lines[line][:character])
    prefix = "\n".join(prefix_parts)
    if len(prefix) > _PREFIX_MAX_CHARS:
        prefix = prefix[-_PREFIX_MAX_CHARS:]

    suffix_parts: list[str] = []
    if line < len(doc_lines):
        suffix_parts.append(doc_lines[line][character:])
        suffix_parts.extend(doc_lines[line + 1 :])
    suffix = "\n".join(suffix_parts)
    if len(suffix) > _SUFFIX_MAX_CHARS:
        suffix = suffix[:_SUFFIX_MAX_CHARS]

    return prefix, suffix


def _fetch_completion(
    prefix: str,
    suffix: str,
) -> str | None:
    if not _API_KEY:
        _log("DEEPSEEK_API_KEY is not set")
        return None

    body = json.dumps(
        {
            "model": _MODEL,
            "prompt": prefix,
            "suffix": suffix,
            "max_tokens": _MAX_TOKENS,
            "temperature": 0.1,
            "top_p": 0.9,
            "stop": ["\n\n\n"],
        },
    ).encode("utf-8")

    req = urllib.request.Request(  # noqa: S310
        _ENDPOINT,
        data=body,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {_API_KEY}",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=15) as resp:  # noqa: S310
            data = json.loads(resp.read().decode("utf-8"))
            choices = data.get("choices", [])
            if choices and choices[0].get("text"):
                return choices[0]["text"].rstrip()
    except OSError as error:
        _log(f"API request failed: {error}")
    except json.JSONDecodeError as error:
        _log(f"API response parse error: {error}")

    return None


def _handle_did_open(
    params: Mapping[str, Any],
) -> None:
    uri = params["textDocument"]["uri"]
    with _state_lock:
        _documents[uri] = params["textDocument"]["text"]
        _document_versions[uri] = _document_versions.get(uri, 0) + 1
        pending_id = _invalidate_inline_completions_locked()

    _send_response(pending_id, None)


def _handle_did_change(
    params: Mapping[str, Any],
) -> None:
    changes = params.get("contentChanges", [])
    if changes:
        uri = params["textDocument"]["uri"]
        with _state_lock:
            _documents[uri] = changes[0]["text"]
            _document_versions[uri] = _document_versions.get(uri, 0) + 1
            pending_id = _invalidate_inline_completions_locked()

        _send_response(pending_id, None)


def _handle_did_close(
    params: Mapping[str, Any],
) -> None:
    uri = params["textDocument"]["uri"]
    with _state_lock:
        _documents.pop(uri, None)
        _document_versions.pop(uri, None)
        pending_id = _invalidate_inline_completions_locked()

    _send_response(pending_id, None)


def _handle_initialize() -> dict[str, Any]:
    return {
        "capabilities": {
            "textDocumentSync": 1,  # Full
            "inlineCompletionProvider": {},
        },
        "serverInfo": {
            "name": "auto-completion",
            "version": "0.1.0",
        },
    }


def _handle_inline_completion(
    msg_id: Any,
    params: Mapping[str, Any],
) -> None:
    uri = params["textDocument"]["uri"]
    pos = params["position"]
    line = pos["line"]
    character = pos["character"]

    global _completion_token
    global _pending_inline_completion

    with _state_lock:
        stale_pending_id = _cancel_pending_inline_completion_locked()
        _completion_token += 1
        token = _completion_token

        text = _documents.get(uri, "")
        document_version = _document_versions.get(uri, 0)
        prefix, suffix = _extract_fim(text, line, character)

        if not prefix and not suffix:
            _pending_inline_completion = None
            current_id = msg_id
        else:
            timer = threading.Timer(
                _DEBOUNCE_MS / 1000,
                _run_inline_completion,
                args=(msg_id, token, uri, document_version, prefix, suffix),
            )
            timer.daemon = True
            _pending_inline_completion = {
                "id": msg_id,
                "timer": timer,
                "token": token,
            }
            current_id = None
            timer.start()

    _send_response(stale_pending_id, None)
    _send_response(current_id, None)


def _run_inline_completion(
    msg_id: Any,
    token: int,
    uri: str,
    document_version: int,
    prefix: str,
    suffix: str,
) -> None:
    global _pending_inline_completion

    with _state_lock:
        pending = _pending_inline_completion
        if pending is not None and pending["token"] == token:
            _pending_inline_completion = None

    text = _fetch_completion(prefix, suffix)

    with _state_lock:
        canceled = msg_id in _canceled_request_ids
        if canceled:
            _canceled_request_ids.discard(msg_id)

        stale = (
            token != _completion_token
            or _document_versions.get(uri) != document_version
        )

    if canceled:
        _send_error(msg_id, _REQUEST_CANCELLED, "Request cancelled")
        return

    if stale or text is None:
        _send_response(msg_id, None)
        return

    _send_response(msg_id, {"items": [{"insertText": text}]})


def _handle_cancel_request(
    params: Mapping[str, Any],
) -> None:
    global _completion_token
    global _pending_inline_completion

    cancel_id = params.get("id")
    if cancel_id is None:
        return

    canceled_pending = False
    with _state_lock:
        _canceled_request_ids.add(cancel_id)
        pending = _pending_inline_completion
        if pending is not None and pending["id"] == cancel_id:
            pending["timer"].cancel()
            _pending_inline_completion = None
            _canceled_request_ids.discard(cancel_id)
            _completion_token += 1
            canceled_pending = True

    if canceled_pending:
        _send_error(cancel_id, _REQUEST_CANCELLED, "Request cancelled")


def main() -> None:
    _log("auto-completion LSP server started")

    while True:
        msg = _read_message()
        if msg is None:
            break

        method = msg.get("method")
        msg_id = msg.get("id")
        params = msg.get("params", {})

        try:
            if method == "initialize":
                result = _handle_initialize()
                _send_response(msg_id, result)

            elif method == "initialized":
                pass

            elif method == "$/cancelRequest":
                _handle_cancel_request(params)

            elif method == "textDocument/didOpen":
                _handle_did_open(params)

            elif method == "textDocument/didChange":
                _handle_did_change(params)

            elif method == "textDocument/didClose":
                _handle_did_close(params)

            elif method == "textDocument/inlineCompletion":
                _handle_inline_completion(msg_id, params)

            elif method == "shutdown":
                _send_response(msg_id, None)

            elif method == "exit":
                break

            elif msg_id is not None:
                _send_error(msg_id, -32601, f"Method not found: {method}")

        except BaseException as exc:  # noqa: BLE001
            _log(f"Error handling {method}: {exc}")
            if msg_id is not None:
                _send_error(msg_id, -32603, str(exc))


if __name__ == "__main__":
    main()
